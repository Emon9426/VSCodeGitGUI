{
  "name": "commitmap",
  "displayName": "%ext.displayName%",
  "description": "%ext.description%",
  "version": "0.6.0",
  "publisher": "EmonZhang3438",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Emon9426/VSCodeGitGUI.git"
  },
  "bugs": {
    "url": "https://github.com/Emon9426/VSCodeGitGUI/issues"
  },
  "homepage": "https://github.com/Emon9426/VSCodeGitGUI#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "commitmap",
          "title": "%viewContainer.name%",
          "icon": "media/commitmap.svg"
        }
      ]
    },
    "views": {
      "commitmap": [
        {
          "id": "commitmap.repos",
          "name": "%view.repos%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "commitmap.repos",
        "contents": "%welcome.noRepos%"
      }
    ],
    "commands": [
      {
        "command": "commitmap.open",
        "title": "%cmd.open%"
      },
      {
        "command": "commitmap.openRepo",
        "title": "%cmd.openRepo%"
      },
      {
        "command": "commitmap.refreshTree",
        "title": "%cmd.refreshTree%"
      },
      {
        "command": "commitmap.fetch",
        "title": "%cmd.fetch%"
      },
      {
        "command": "commitmap.pull",
        "title": "%cmd.pull%"
      },
      {
        "command": "commitmap.push",
        "title": "%cmd.push%"
      }
    ],
    "keybindings": [
      {
        "command": "commitmap.open",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "commitmap.openRepo",
          "when": "false"
        },
        {
          "command": "commitmap.refreshTree",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "commitmap.open",
          "when": "view == commitmap.repos",
          "group": "navigation"
        },
        {
          "command": "commitmap.refreshTree",
          "when": "view == commitmap.repos",
          "group": "navigation"
        }
      ],
      "scm/title": [
        {
          "command": "commitmap.open",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "title": "CommitMap",
      "properties": {
        "commitmap.gitPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%cfg.gitPath%"
        },
        "commitmap.commitPageSize": {
          "type": "number",
          "default": 500,
          "minimum": 100,
          "maximum": 5000,
          "description": "%cfg.commitPageSize%"
        },
        "commitmap.maxAutoLoad": {
          "type": "number",
          "default": 20000,
          "description": "%cfg.maxAutoLoad%"
        },
        "commitmap.fetchOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.fetchOnOpen%"
        },
        "commitmap.fetchPrune": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.fetchPrune%"
        },
        "commitmap.defaultPullStrategy": {
          "type": "string",
          "default": "merge",
          "enum": [
            "merge",
            "rebase",
            "ff-only"
          ],
          "description": "%cfg.defaultPullStrategy%"
        },
        "commitmap.dateFormat": {
          "type": "string",
          "default": "datetime",
          "enum": [
            "datetime",
            "relative",
            "iso"
          ],
          "enumDescriptions": [
            "%cfg.dateFormat.datetime%",
            "%cfg.dateFormat.relative%",
            "%cfg.dateFormat.iso%"
          ],
          "description": "%cfg.dateFormat%"
        },
        "commitmap.rowHeight": {
          "type": "string",
          "default": "default",
          "enum": [
            "compact",
            "default",
            "loose"
          ],
          "description": "%cfg.rowHeight%"
        },
        "commitmap.graphStyle": {
          "type": "string",
          "default": "curved",
          "enum": [
            "curved",
            "angular"
          ],
          "description": "%cfg.graphStyle%"
        },
        "commitmap.graphColumnWidth": {
          "type": "number",
          "default": 180,
          "minimum": 120,
          "maximum": 260,
          "description": "%cfg.graphColumnWidth%"
        },
        "commitmap.showRemoteChips": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.showRemoteChips%"
        },
        "commitmap.maxTagChips": {
          "type": "number",
          "default": 2,
          "description": "%cfg.maxTagChips%"
        },
        "commitmap.detailPanelPosition": {
          "type": "string",
          "default": "bottom",
          "enum": [
            "bottom",
            "right"
          ],
          "description": "%cfg.detailPanelPosition%"
        },
        "commitmap.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "zh-CN",
            "en"
          ],
          "description": "%cfg.language%"
        },
        "commitmap.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.showStatusBarItem%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "test": "vitest run",
    "assets": "node svg2png.js",
    "package": "npm run assets && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.21.5",
    "sharp": "^0.35.3",
    "typescript": "^5.4.5",
    "vitest": "^2.1.8"
  }
}

{
  "name": "gitboard",
  "displayName": "%ext.displayName%",
  "description": "%ext.description%",
  "version": "0.19.2",
  "publisher": "EmonZhang3438",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Emon9426/VSCodeGitGUI.git"
  },
  "bugs": {
    "url": "https://github.com/Emon9426/VSCodeGitGUI/issues"
  },
  "homepage": "https://github.com/Emon9426/VSCodeGitGUI#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitboard",
          "title": "%viewContainer.name%",
          "icon": "media/gitboard.svg"
        }
      ]
    },
    "views": {
      "gitboard": [
        {
          "id": "gitboard.repos",
          "name": "%view.repos%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitboard.repos",
        "contents": "%welcome.noRepos%"
      }
    ],
    "commands": [
      {
        "command": "gitboard.open",
        "title": "%cmd.open%"
      },
      {
        "command": "gitboard.openRepo",
        "title": "%cmd.openRepo%"
      },
      {
        "command": "gitboard.refreshTree",
        "title": "%cmd.refreshTree%"
      },
      {
        "command": "gitboard.fetch",
        "title": "%cmd.fetch%"
      },
      {
        "command": "gitboard.pull",
        "title": "%cmd.pull%"
      },
      {
        "command": "gitboard.push",
        "title": "%cmd.push%"
      },
      {
        "command": "gitboard.commit",
        "title": "%cmd.commit%"
      },
      {
        "command": "gitboard.setLanguage",
        "title": "%cmd.setLanguage%"
      },
      {
        "command": "gitboard.showFileHistory",
        "title": "%cmd.showFileHistory%"
      }
    ],
    "keybindings": [
      {
        "command": "gitboard.open",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      },
      {
        "command": "gitboard.commit",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gitboard.openRepo",
          "when": "false"
        },
        {
          "command": "gitboard.refreshTree",
          "when": "false"
        },
        {
          "command": "gitboard.showFileHistory",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "gitboard.showFileHistory",
          "when": "resourceScheme == file && !listMultiSelection",
          "group": "gitboard@1"
        }
      ],
      "view/title": [
        {
          "command": "gitboard.open",
          "when": "view == gitboard.repos",
          "group": "navigation"
        },
        {
          "command": "gitboard.refreshTree",
          "when": "view == gitboard.repos",
          "group": "navigation"
        }
      ],
      "scm/title": [
        {
          "command": "gitboard.open",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "title": "GitBoard",
      "properties": {
        "gitboard.gitPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%cfg.gitPath%"
        },
        "gitboard.commitPageSize": {
          "type": "number",
          "default": 500,
          "minimum": 100,
          "maximum": 5000,
          "description": "%cfg.commitPageSize%"
        },
        "gitboard.logOrder": {
          "type": "string",
          "default": "topo",
          "enum": [
            "topo",
            "date"
          ],
          "enumDescriptions": [
            "%cfg.logOrder.topo%",
            "%cfg.logOrder.date%"
          ],
          "description": "%cfg.logOrder%"
        },
        "gitboard.maxAutoLoad": {
          "type": "number",
          "default": 20000,
          "description": "%cfg.maxAutoLoad%"
        },
        "gitboard.fetchOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.fetchOnOpen%"
        },
        "gitboard.autoFetchInterval": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 1440,
          "description": "%cfg.autoFetchInterval%"
        },
        "gitboard.netStallTimeout": {
          "type": "number",
          "default": 180,
          "minimum": 0,
          "description": "%cfg.netStallTimeout%"
        },
        "gitboard.fetchPrune": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.fetchPrune%"
        },
        "gitboard.pullFetchSummary": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.pullFetchSummary%"
        },
        "gitboard.defaultPullStrategy": {
          "type": "string",
          "default": "merge",
          "enum": [
            "merge",
            "rebase",
            "ff-only"
          ],
          "description": "%cfg.defaultPullStrategy%"
        },
        "gitboard.dateFormat": {
          "type": "string",
          "default": "datetime",
          "enum": [
            "datetime",
            "relative",
            "iso"
          ],
          "enumDescriptions": [
            "%cfg.dateFormat.datetime%",
            "%cfg.dateFormat.relative%",
            "%cfg.dateFormat.iso%"
          ],
          "description": "%cfg.dateFormat%"
        },
        "gitboard.rowHeight": {
          "type": "string",
          "default": "default",
          "enum": [
            "compact",
            "default",
            "loose"
          ],
          "description": "%cfg.rowHeight%"
        },
        "gitboard.graphStyle": {
          "type": "string",
          "default": "github",
          "enum": [
            "github",
            "curved",
            "angular"
          ],
          "description": "%cfg.graphStyle%"
        },
        "gitboard.graphColumnWidth": {
          "type": "number",
          "default": 180,
          "minimum": 120,
          "maximum": 260,
          "description": "%cfg.graphColumnWidth%"
        },
        "gitboard.showRemoteChips": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.showRemoteChips%"
        },
        "gitboard.maxTagChips": {
          "type": "number",
          "default": 2,
          "description": "%cfg.maxTagChips%"
        },
        "gitboard.detailPanelPosition": {
          "type": "string",
          "default": "bottom",
          "enum": [
            "bottom",
            "right"
          ],
          "description": "%cfg.detailPanelPosition%"
        },
        "gitboard.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "zh-CN",
            "en"
          ],
          "description": "%cfg.language%"
        },
        "gitboard.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.showStatusBarItem%"
        },
        "gitboard.startView": {
          "type": "string",
          "default": "graph",
          "enum": [
            "graph",
            "work",
            "last"
          ],
          "enumDescriptions": [
            "%cfg.startView.graph%",
            "%cfg.startView.work%",
            "%cfg.startView.last%"
          ],
          "description": "%cfg.startView%"
        },
        "gitboard.ai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.ai.enabled%"
        },
        "gitboard.ai.modelFamily": {
          "type": "string",
          "default": "",
          "description": "%cfg.ai.modelFamily%"
        },
        "gitboard.ai.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "zh-cn"
          ],
          "description": "%cfg.ai.language%"
        },
        "gitboard.ai.learnFromHistory": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.ai.learnFromHistory%"
        },
        "gitboard.ai.useWorkspaceInstructions": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.ai.useWorkspaceInstructions%"
        },
        "gitboard.commit.clearMessage": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.commit.clearMessage%"
        },
        "gitboard.commit.pushAfter": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.commit.pushAfter%"
        },
        "gitboard.revealSelectStyle": {
          "type": "string",
          "enum": [
            "classic",
            "separate",
            "quoted"
          ],
          "default": "classic",
          "description": "%cfg.revealSelectStyle%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "test": "vitest run",
    "assets": "node svg2png.js",
    "package": "npm run assets && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.21.5",
    "sharp": "^0.35.3",
    "typescript": "^5.4.5",
    "vitest": "^2.1.8"
  }
}
